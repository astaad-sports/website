# Copy to .env.local and fill in. Never commit .env.local.

# --- Neon Postgres -----------------------------------------------------------
# Neon console > your project > Connect. Pick the region closest to your
# customers (Singapore, aws-ap-southeast-1, for India).
# DATABASE_URL is the pooled string (host contains "-pooler") used by the app.
# DATABASE_URL_UNPOOLED is the direct string, used by migrations.
# Use sslmode=verify-full: node-postgres warns about sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# --- Firebase web app (public, sent to the browser) --------------------------
# Firebase console > Project settings > General > Your apps > Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Firebase Admin (secret, server only) ------------------------------------
# Project settings > Service accounts > Generate new private key. Copy
# client_email and private_key from the downloaded JSON. Keep the \n escapes.
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Razorpay (payments) ------------------------------------------------------
# Razorpay dashboard > Account & Settings > API Keys. Use test keys
# (rzp_test_...) until you go live. The key id is public; the secret is not.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard > Webhooks: add https://<your-domain>/api/webhooks/razorpay with
# the order.paid and refund.processed events, and put the secret you choose
# here. refund.processed emails the customer once you make a refund.
RAZORPAY_WEBHOOK_SECRET=""
# Test-mode keys (rzp_test_...) for test accounts' orders, needed once the keys
# above are live. While the keys above are test keys, test accounts use those.
RAZORPAY_TEST_KEY_ID=""
RAZORPAY_TEST_KEY_SECRET=""
# Buy now opens Razorpay Magic Checkout, which takes the mobile number, address,
# coupon and payment. Razorpay enables it per account, and its dashboard needs
# the three addresses listed in the admin's Settings > Payment. The webhook
# above should be set too.

# --- Store admins ---------------------------------------------------------------
# Comma-separated emails that can open /admin/orders to ship orders. The
# account's email must be verified (Google sign-in always is). Each address
# also gets an email for every new order, unpaid order and new review, and a
# copy of each later email to the customer (packed, shipped, delivered,
# cancelled, refunded).
ADMIN_EMAILS=""

# --- Test accounts --------------------------------------------------------------
# Comma-separated emails that shop like customers, but every order they place
# is a test: paid in Razorpay's test mode, never taken from stock, and listed
# under Test in /admin/orders. Sign up on /login with the email; it does not
# need to be verified.
TEST_ACCOUNT_EMAILS=""

# --- Instagram feed on the home page -----------------------------------------
# Without this the home page shows Instagram's own embed of @astaad.sports.
# With it, the latest posts show in the store's own grid. One-time setup:
#  1. The Instagram account must be a professional one (Business or Creator):
#     Instagram > Settings > Account type and tools.
#  2. developers.facebook.com > My Apps > Create app, with the use case
#     "Manage messaging & content on Instagram".
#  3. In the app: Instagram > API setup with Instagram login > Generate access
#     tokens > Add account, sign in as @astaad.sports and allow access.
#  4. Paste the token here (and in Vercel for Production), then redeploy.
# Tokens last 60 days; the site refreshes this one weekly and keeps the new
# one in the database (instagram_token), so this is needed once. Pasting a
# new token here starts over from it.
INSTAGRAM_ACCESS_TOKEN=""
# --- Resend (order emails) --------------------------------------------------
# resend.com > API Keys: create a key with sending access. Without it no
# emails are sent, and nothing else is affected.
RESEND_API_KEY=""
# Who emails come from, on a domain verified in Resend (Domains), e.g.
# "Astaad Sports <no-reply@astaadsports.com>". Left empty, Resend's test sender
# onboarding@resend.dev is used, which only delivers to your own Resend address.
EMAIL_FROM=""
# Any long random value, e.g. from `openssl rand -hex 32`. Vercel Cron sends it
# when it calls the daily check for unpaid orders (vercel.json), and the site
# turns away any other caller. Left empty, no unpaid-order alerts are sent.
CRON_SECRET=""
# The live site's address, e.g. "https://astaadsports.com", with no trailing
# slash: links in emails, and the address search engines are given for every
# page (canonical links, the sitemap). Use the exact address the site answers
# on, not one that redirects. Left empty, it is the Vercel production domain,
# or http://localhost:3000 locally.
SITE_URL=""
# Optional: Google Search Console's "HTML tag" verification code (the content
# value only). Not needed when the domain is verified with a DNS record.
GOOGLE_SITE_VERIFICATION=""

# --- WhatsApp (order updates and the chat bot) ---------------------------------
# Meta's WhatsApp Cloud API, straight from Meta: the store's own Meta app is its
# own Tech Provider. Without these nothing is sent, and nothing else is affected.
# The store's number +91 88820 74750 stays on the WhatsApp Business app (Meta's
# "coexistence"); replies sent from the app keep the bot quiet in that chat for
# 12 hours. One-time setup:
#  1. business.facebook.com > Security centre: verify the business.
#  2. developers.facebook.com > My Apps > Create app (type Business), add the
#     WhatsApp product, then become a Tech Provider (WhatsApp > Quickstart >
#     Become a Tech Provider) and get advanced access to
#     whatsapp_business_messaging and whatsapp_business_management through App
#     Review. Add the live domain under App settings > Basic and Facebook Login
#     for Business > Settings (allowed domains for the JavaScript SDK).
#  3. Facebook Login for Business > Configurations > Create: login variation
#     "WhatsApp Embedded Signup", those two permissions. Its id is
#     NEXT_PUBLIC_WHATSAPP_SIGNUP_CONFIG_ID.
#  4. In the app: WhatsApp > Configuration > Webhook: callback URL
#     <SITE_URL>/api/webhooks/whatsapp, verify token WHATSAPP_VERIFY_TOKEN, then
#     subscribe to messages, smb_message_echoes, history, smb_app_state_sync and
#     account_update.
#  5. On the phone: WhatsApp Business app 2.24.17 or later, and turn off its
#     greeting and away messages (they would answer alongside the bot).
#  6. Admin > Settings > WhatsApp > Connect WhatsApp, with the Business app open
#     on the phone (it starts the chat and contact syncs, which Meta allows only
#     within 24 hours). Then Submit for review there, and add a payment method
#     in WhatsApp Manager.
NEXT_PUBLIC_META_APP_ID=""
NEXT_PUBLIC_WHATSAPP_SIGNUP_CONFIG_ID=""
# App settings > Basic > App secret: Meta signs every webhook with it, and
# Connect WhatsApp needs it to finish.
WHATSAPP_APP_SECRET=""
# Any long random value, e.g. from `openssl rand -hex 32`, also typed into the webhook settings.
WHATSAPP_VERIFY_TOKEN=""
# The store's WhatsApp number, e.g. "+91 88820 74750". Turns on the opt-in at
# checkout, the notice under Buy now and Link WhatsApp on the account page, so
# set it once the rest works. Public: it is in the site's pages.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
# Comma-separated numbers that get a WhatsApp alert for each new order and can
# send "SHIP <order number> <tracking ID>" to the bot to mark an order shipped.
# Personal numbers: the store's own number is left out, as it can't message itself.
ADMIN_WHATSAPP_NUMBERS=""
# Instead of Connect WhatsApp: a System User token and the ids from WhatsApp >
# API setup. When the token and number id are set they win over a connected
# number; `bun scripts/whatsapp-templates.ts` then submits the templates.
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Optional: WHATSAPP_GRAPH_VERSION (default v26.0) and WHATSAPP_TEMPLATE_LANGUAGE (default en).

# --- Optional: local Firebase Auth emulator ----------------------------------
# Uncomment both to sign in against the emulator instead of real Firebase.
# With the emulator, FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY are not needed.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
